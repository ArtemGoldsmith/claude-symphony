{
  "name": "claude-symphony",
  "version": "0.0.1",
  "description": "TypeScript port of openai/symphony for Claude Code: a Linear-driven daemon that dispatches autonomous coding-agent runs into per-issue git worktrees.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Artem Saribekyan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArtemGoldsmith/claude-symphony.git"
  },
  "bugs": {
    "url": "https://github.com/ArtemGoldsmith/claude-symphony/issues"
  },
  "homepage": "https://github.com/ArtemGoldsmith/claude-symphony#readme",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.2",
  "bin": {
    "claude-symphony": "./dist/bin/claude-symphony.js",
    "claude-symphony-control-plane": "./dist/bin/control-plane.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE",
    "SPEC-claude.md",
    "PARITY.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx bin/claude-symphony.ts",
    "dev:control-plane": "tsx bin/control-plane.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.0",
    "@hono/node-server": "^2.0.4",
    "@linear/sdk": "^39.0.0",
    "gray-matter": "^4.0.3",
    "hono": "^4.12.23",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "proper-lockfile": "^4.1.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/proper-lockfile": "^4.1.4",
    "@vitest/coverage-v8": "^2.1.0",
    "prettier": "^3.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
